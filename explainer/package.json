{
  "name": "dice-explainer",
  "private": true,
  "description": "How Dice Become DPR: a scroll-driven explainer for @yipe/dice, deployed to GitHub Pages.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p .",
    "check:data": "tsx scripts/check-data.ts",
    "check:snippets": "node scripts/check-snippets.mjs",
    "check:formula": "python3 scripts/check-formula.py",
    "check": "npm run typecheck && npm run check:data && npm run check:snippets && npm run check:formula",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@remotion/player": "4.0.534",
    "@yipe/dice": "0.19.0",
    "katex": "0.16.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.4"
  }
}
